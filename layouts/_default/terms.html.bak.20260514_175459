{{- define "main" }}
<section class="wst-tags-hero">
  <span class="wst-tags-eyebrow">Observatory · Editorial Index</span>
  <h1 class="wst-tags-title">{{ .Title }} — Reading Invisible Systems</h1>
  <p class="wst-tags-subtitle">Cartographie thématique de WetSea Observatory. Chaque domaine regroupe les articles &amp; vidéos issus du pipeline NotebookLM, organisés par canal YouTube.</p>
</section>

<section class="wst-tags-grid">
{{- $coords := dict
    "cybersecurity" "53°N · 09°E"
    "devops-cloud"  "37°N · 122°W"
    "ia-travail"    "47°N · 02°W"
    "prospective"   "00°N · 180°W"
}}
{{ range $name, $taxonomy := .Site.Taxonomies.tags }}
  {{- $tag := $.Site.GetPage (printf "/tags/%s" $name) }}
  {{- $count := len $taxonomy }}
  {{- $coord := index $coords $name | default "—°N · —°W" }}
  <a href="{{ $tag.Permalink }}" class="wst-tag-card wst-tag-card--{{ $name }}" aria-label="{{ $tag.Title }} — {{ $count }} articles">
    <div class="wst-tag-card__cover"></div>
    <div class="wst-tag-card__body">
      <span class="wst-tag-card__coord">{{ $coord }}</span>
      <h2 class="wst-tag-card__title">{{ $tag.Title }}</h2>
      <span class="wst-tag-card__count">{{ $count }} article{{ if gt $count 1 }}s{{ end }}</span>
      {{ with $tag.Description }}<p class="wst-tag-card__desc">{{ . }}</p>{{ end }}
    </div>
  </a>
{{ end }}
</section>

<aside class="wst-tags-footnote">
  <span class="wst-tags-footnote__rule"></span>
  <p>Observations classées par canal YouTube. Canal A — <em>@discover-allin360</em> · Canal B — <em>@wetseatech</em>.</p>
</aside>
{{- end }}
