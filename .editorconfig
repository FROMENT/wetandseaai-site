# Configuration éditeur générique — applicable à tout éditeur respectant
# .editorconfig (VSCode, JetBrains, Sublime, Vim avec plugin, etc.)
# Évite les transformations automatiques qui cassent le YAML frontmatter Hugo.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Fichiers générés par article_publish.py — hands off
[content/**.md]
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = unset
indent_size = unset
